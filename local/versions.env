# Every version the local setup depends on, in one place. All machines get the same Kubernetes and Argo CD.
KIND_MIN_VERSION=0.25.0
KIND_NODE_IMAGE=kindest/node:v1.31.2
ARGOCD_VERSION=v2.13.2
RABBITMQ_OPERATOR_VERSION=v2.11.0
CLUSTER_NAME=kuasar
NAMESPACE=kuasar-local
DEPLOY_REPO_URL=https://github.com/moazzamAli06/kuasar-deploy.git
DEPLOY_BRANCH=local
MIN_DOCKER_MEMORY_GB=8
MIN_DOCKER_CPUS=4
KIND_VERSION=v0.25.0
KUBECTL_VERSION=v1.31.4
