# Bumped together and tested on a clean cluster (see docs/UPGRADING.md). Renovate opens pull requests for them.
# Every version the local setup depends on, in one place. All machines get the same Kubernetes and Argo CD.
KIND_MIN_VERSION=0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
# renovate: datasource=github-releases depName=argoproj/argo-cd
ARGOCD_VERSION=v3.6.1
# renovate: datasource=github-releases depName=rabbitmq/cluster-operator
RABBITMQ_OPERATOR_VERSION=v2.21.0
# renovate: datasource=github-releases depName=projectcalico/calico
CALICO_VERSION=v3.33.1
CLUSTER_NAME=kuasar
NAMESPACE=kuasar-local
DEPLOY_REPO_URL=https://github.com/moazzamAli06/kuasar-deploy.git
DEPLOY_BRANCH=local
MIN_DOCKER_MEMORY_GB=8
MIN_DOCKER_CPUS=4
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.33.0
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.36.6
